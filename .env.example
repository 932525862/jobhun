# Telegram Bot Token (@BotFather dan olasiz)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# E'lonlar chiqariladigan kanal ID si
CHANNEL_ID=@your_channel_username

# Bot username (@username ko'rinishida, @ belgisisiz)
BOT_USERNAME=your_bot_username

# Google Gemini AI API Key (ixtiyoriy, AI funksiyalari uchun)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Web App URL (production HTTPS URL)
WEB_APP_URL=https://your-app-domain.com

# Server port (odatda 3000)
PORT=3000
